              </ListBox>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{x:Static core:EffectDefinitions.AllDefinitions}" DisplayMemberPath="DisplayName" SelectedValue="{Binding NewEffectKind, Mode=TwoWay}" SelectedValuePath="Kind" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                <Button Grid.Column="1" Content="追加" Click="AddEffectButton_Click" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
              </Grid>
              <TextBlock Text="{x:Static core:EffectDefinitions.HelpText}" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Text="可視化" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource AppForeground}" Visibility="{Binding IsVisualizationClipSelected, Converter={StaticResource BoolToVis}}" />
            <StackPanel Visibility="{Binding IsVisualizationClipSelected, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="種類" Foreground="{StaticResource AppForeground}" />
