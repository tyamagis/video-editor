                <ComboBoxItem Content="スペクトル" Tag="{x:Static core:VisualizationKind.Spectrum}" />
                <ComboBoxItem Content="波形（オシロスコープ）" Tag="{x:Static core:VisualizationKind.Waveform}" />
                <ComboBoxItem Content="リサジュー" Tag="{x:Static core:VisualizationKind.Lissajous}" />
              </ComboBox>
              <TextBlock Text="音源クリップ" Foreground="{StaticResource AppForeground}" />
              <ComboBox ItemsSource="{Binding AudioSourceClips}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedVisualizationSourceClipId, Mode=TwoWay}" Margin="0,0,0,6" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
              <TextBlock Text="色（#RRGGBB）" Foreground="{StaticResource AppForeground}" />
              <TextBox Text="{Binding SelectedVisualizationColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
              <StackPanel Visibility="{Binding ShowSpectrumSettings, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="帯域" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                  <TextBox Grid.Column="1" Text="{Binding SelectedVisualizationLowHz, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                  <TextBlock Grid.Column="2" Text="〜" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                  <TextBox Grid.Column="3" Text="{Binding SelectedVisualizationHighHz, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                  <TextBlock Grid.Column="4" Text="Hz" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="本数" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                  <TextBox Grid.Column="1" Text="{Binding SelectedVisualizationBandCount, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                  <TextBlock Grid.Column="2" Text="ゲイン" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                  <TextBox Grid.Column="3" Text="{Binding SelectedVisualizationGain, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                </Grid>
                <CheckBox Content="対数スケール（オフで線形）" IsChecked="{Binding SelectedVisualizationLogarithmic, Mode=TwoWay}" Foreground="{StaticResource AppForeground}" />
              </StackPanel>
              <StackPanel Visibility="{Binding ShowWaveformSettings, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="線の太さ" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                  <TextBox Grid.Column="1" Text="{Binding SelectedVisualizationLineWidth, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                  <TextBlock Grid.Column="2" Text="ゲイン" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                  <TextBox Grid.Column="3" Text="{Binding SelectedVisualizationGain, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="表示区間" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                  <TextBox Grid.Column="1" Text="{Binding SelectedVisualizationWindowSeconds, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                  <TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
                </Grid>
              </StackPanel>
              <StackPanel Visibility="{Binding ShowLissajousSettings, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="線の太さ" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                  <TextBox Grid.Column="1" Text="{Binding SelectedVisualizationLineWidth, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                  <TextBlock Grid.Column="2" Text="ゲイン" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                  <TextBox Grid.Column="3" Text="{Binding SelectedVisualizationGain, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="残像" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                  <TextBox Grid.Column="1" Text="{Binding SelectedVisualizationTrailSeconds, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
