                </Grid>
              </StackPanel>
              <TextBlock Text="{Binding VisualizationHint}" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock Text="位置・大きさはキーフレーム欄（位置 X/Y・拡大率）で動かせます。ゲイン・線の太さ・表示区間・残像もキーフレームで動かせます。音連動バインドも使えます。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Text="音連動" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource AppForeground}" />
            <TextBlock Text="音声クリップ自体には映像パラメータが無いため、バインドは付けられません。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding IsAudioClipSelected, Converter={StaticResource BoolToVis}}" />
            <StackPanel IsEnabled="{Binding CanHaveAudioBindings}">
              <TextBlock Text="バインド（音の帯域でパラメータを動かす）" Foreground="{StaticResource AppForeground}" />
              <ListBox ItemsSource="{Binding AudioBindingRows}" MaxHeight="320"
                       Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{StaticResource ControlBorder}" BorderThickness="1" CornerRadius="3" Padding="4" Margin="0,0,0,4">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                          </Grid.ColumnDefinitions>
                          <ComboBox Grid.Column="0" ItemsSource="{Binding ParameterOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding ParameterName, Mode=TwoWay}" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                          <Button Grid.Column="1" Content="×" Padding="0" Click="DeleteAudioBindingButton_Click" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                        </Grid>
                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding DataContext.AudioSourceClips, RelativeSource={RelativeSource AncestorType=ListBox}}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SourceClipId, Mode=TwoWay}" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="帯域" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                          <TextBox Grid.Column="1" Text="{Binding LowHz, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                          <TextBlock Grid.Column="2" Text="〜" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                          <TextBox Grid.Column="3" Text="{Binding HighHz, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                          <TextBlock Grid.Column="4" Text="Hz" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="出力" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                          <TextBox Grid.Column="1" Text="{Binding MinValue, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                          <TextBlock Grid.Column="2" Text="〜" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                          <TextBox Grid.Column="3" Text="{Binding MaxValue, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="感度" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                          <TextBox Grid.Column="1" Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                          <TextBlock Grid.Column="2" Text="しきい値" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
                          <TextBox Grid.Column="3" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <ComboBox Grid.Column="0" SelectedValue="{Binding Combine, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                            <ComboBoxItem Content="加算" Tag="{x:Static core:AudioBindCombine.Add}" />
                            <ComboBoxItem Content="乗算" Tag="{x:Static core:AudioBindCombine.Multiply}" />
                            <ComboBoxItem Content="上書き" Tag="{x:Static core:AudioBindCombine.Override}" />
                          </ComboBox>
                          <CheckBox Grid.Column="1" Content="反転" IsChecked="{Binding Invert, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource AppForeground}" />
                          <CheckBox Grid.Column="2" Content="有効" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" ItemsSource="{Binding AudioBindingParameterOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding NewAudioBindingParameter, Mode=TwoWay}" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                <Button Grid.Column="1" Content="追加" Click="AddAudioBindingButton_Click" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
              </Grid>
              <TextBlock Text="{Binding AudioBindingHint}" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock Text="加算：キーフレーム値に変化分を足す ／ 乗算：キーフレーム値に掛ける ／ 上書き：置き換える。感度は帯域エネルギーへの倍率、しきい値はそれ以下を無音扱いにする値。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Text="無音カット" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource AppForeground}" />
            <StackPanel IsEnabled="{Binding HasAudioClip}">
              <TextBlock Text="映像クリップの場合、映像も一緒に切れます。同じトラックの後ろのクリップは前に詰まります。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding IsVideoClipSelected, Converter={StaticResource BoolToVis}}" />
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
