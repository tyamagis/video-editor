              </Grid>
              <TextBlock Text="{Binding SilenceDetectionText}" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock Text="しきい値以下の音が最短無音以上続いた区間を、両端に余白を残して切り取ります。検出結果を確認してから「適用」を押してください（1回の操作でアンドゥできます）。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Text="ノイズ除去" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource AppForeground}" />
            <StackPanel IsEnabled="{Binding HasAudioClip}">
              <CheckBox Content="ノイズ除去を有効にする" IsChecked="{Binding SelectedClipNoiseReductionEnabled, Mode=TwoWay}" Foreground="{StaticResource AppForeground}" />
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="強さ" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
                <Slider Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center"
                        Value="{Binding SelectedClipNoiseReductionStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        GotFocus="EditableField_GotFocus" />
                <TextBlock Grid.Column="2" Text="{Binding SelectedClipNoiseReductionStrength, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource AppForeground}" />
              </Grid>
              <TextBlock Text="書き出し時に FFmpeg のノイズ除去（afftdn）で適用されます。プレビューでは効果が聞けません。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Text="マーカー" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource AppForeground}" />
