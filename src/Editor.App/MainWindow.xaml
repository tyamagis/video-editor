<Window x:Class="Editor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Editor.App.Controls"
        xmlns:core="clr-namespace:Editor.Core;assembly=Editor.Core"
        Title="VideoEditor — フェーズ1" Width="1280" Height="800"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource AppForeground}"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" Foreground="{StaticResource AppForeground}">
      <MenuItem Header="ファイル">
        <MenuItem Header="素材を読み込む" Click="ImportMenu_Click" />
        <MenuItem Header="プロジェクトを保存" Click="SaveMenu_Click" />
        <MenuItem Header="名前を付けて保存" Click="SaveAsMenu_Click" />
        <MenuItem Header="プロジェクトを開く" Click="LoadMenu_Click" />
        <Separator />
        <MenuItem Header="テンプレートとして保存…" Click="SaveTemplateMenu_Click" />
        <MenuItem Header="テンプレートから新規作成…" Click="NewFromTemplateMenu_Click" />
        <Separator />
        <MenuItem Header="自動保存から復旧" Click="RecoverAutosaveMenu_Click" IsEnabled="{Binding HasRecoveryAutosave}" />
        <MenuItem Header="自動保存ファイルを破棄" Click="DiscardAutosaveMenu_Click" IsEnabled="{Binding HasRecoveryAutosave}" />
        <Separator />
        <MenuItem Header="自動保存する" IsCheckable="True" IsChecked="{Binding AutosaveEnabled, Mode=TwoWay}" />
        <MenuItem Header="自動保存の間隔" x:Name="AutosaveIntervalMenu" />
        <Separator />
        <MenuItem Header="MP4で書き出す" Click="ExportMenu_Click" />
        <Separator />
        <MenuItem Header="書き出し範囲の開始を再生ヘッドに設定 (I)" Click="ExportInMenu_Click" />
        <MenuItem Header="書き出し範囲の終了を再生ヘッドに設定 (O)" Click="ExportOutMenu_Click" />
        <MenuItem Header="書き出し範囲を全体に戻す" Click="ExportRangeClearMenu_Click" />
      </MenuItem>
      <MenuItem Header="編集">
        <MenuItem Header="元に戻す (Ctrl+Z)" Click="UndoMenu_Click" IsEnabled="{Binding CanUndo}" />
        <MenuItem Header="やり直し (Ctrl+Y)" Click="RedoMenu_Click" IsEnabled="{Binding CanRedo}" />
        <Separator />
        <MenuItem Header="再生ヘッドで分割 (S)" Click="SplitMenu_Click" />
        <MenuItem Header="選択クリップを削除 (Del)" Click="DeleteMenu_Click" />
        <Separator />
        <MenuItem Header="マーカーを追加 (M)" Click="AddMarkerMenu_Click" />
        <MenuItem Header="前のマーカーへ (Ctrl+M)" Click="PrevMarkerMenu_Click" />
        <MenuItem Header="次のマーカーへ (Shift+M)" Click="NextMarkerMenu_Click" />
        <Separator />
        <MenuItem Header="歌詞を一括流し込み…" Click="ImportLyricsMenu_Click" />
      </MenuItem>
    </Menu>

    <ToolBar DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" Foreground="{StaticResource AppForeground}">
      <Button Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" Width="80" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" />
      <Button Content="分割" Command="{Binding SplitCommand}" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" />
      <Button Content="削除" Command="{Binding DeleteClipCommand}" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" />
      <Button Content="テキスト追加" Command="{Binding AddTextClipCommand}" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" />
      <ComboBox SelectedValue="{Binding NewVisualizationKind, Mode=TwoWay}" SelectedValuePath="Tag" Width="90" VerticalAlignment="Center" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
        <ComboBoxItem Content="スペクトル" Tag="{x:Static core:VisualizationKind.Spectrum}" />
        <ComboBoxItem Content="波形" Tag="{x:Static core:VisualizationKind.Waveform}" />
        <ComboBoxItem Content="リサジュー" Tag="{x:Static core:VisualizationKind.Lissajous}" />
      </ComboBox>
      <Button Content="可視化追加" Click="AddVisualizationClipButton_Click" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" />
      <Border Width="1" Background="{StaticResource ControlBorder}" Margin="6,2" />
      <TextBlock Text="BPM" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource AppForeground}" />
      <TextBox Text="{Binding Bpm, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalAlignment="Center" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
      <Button Content="BPMを検出" Click="DetectBpmButton_Click" IsEnabled="{Binding CanDetectBpm}" VerticalAlignment="Center" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" />
      <TextBlock Text="{Binding DetectedBpmText}" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource AppForeground}" />
      <Button Content="適用" Click="ApplyDetectedBpmButton_Click" IsEnabled="{Binding HasPendingDetection}" VerticalAlignment="Center" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" />
      <TextBlock Text="プレビュー" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{StaticResource AppForeground}" />
      <ComboBox x:Name="PreviewResBox" Width="80" SelectionChanged="PreviewResBox_SelectionChanged" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
        <ComboBoxItem Content="フル" IsSelected="True" />
        <ComboBoxItem Content="1/2" />
        <ComboBoxItem Content="1/4" />
      </ComboBox>
      <CheckBox Content="スペクトル" IsChecked="{Binding ShowSpectrum, Mode=TwoWay}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource AppForeground}" />
      <CheckBox Content="リサジュー" IsChecked="{Binding ShowLissajous, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource AppForeground}" />
      <TextBlock Text="{Binding ExportRangeLabel}" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{StaticResource AppForeground}" />
    </ToolBar>

    <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource PanelBackground}" Foreground="{StaticResource AppForeground}">
      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AppForeground}" TextTrimming="CharacterEllipsis" />
      <Separator />
      <TextBlock Text="{Binding AutosaveStatus}" Foreground="{StaticResource MutedForeground}" />
    </StatusBar>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="5" />
        <RowDefinition Height="260" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <GroupBox Grid.Row="0" Grid.Column="0" Header="素材プール" Background="{StaticResource PanelBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ListBox Grid.Row="0" ItemsSource="{Binding MediaItems}" DisplayMemberPath="Display"
                   SelectedItem="{Binding SelectedMediaItem, Mode=TwoWay}"
                   Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}"
                   MouseDoubleClick="MediaList_MouseDoubleClick"
                   PreviewMouseLeftButtonDown="MediaList_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="MediaList_PreviewMouseMove">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <EventSetter Event="MouseDoubleClick" Handler="MediaItem_MouseDoubleClick" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource AppForeground}" />
                <Setter Property="Padding" Value="6,3" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="border" Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="border" Property="Background" Value="#333333" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="border" Property="Background" Value="#3D3D3D" />
                          <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          <Button Grid.Row="1" Content="タイムラインに追加" Margin="0,6,0,0" Click="AddToTimelineButton_Click"
                  Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
        </Grid>
      </GroupBox>

      <controls:PreviewControl x:Name="PreviewControl" Grid.Row="0" Grid.Column="1" />

      <GroupBox Grid.Row="0" Grid.Column="2" Header="インスペクタ" Background="{StaticResource PanelBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="6">
            <StackPanel DataContext="{Binding SelectedClip}">
              <TextBlock Text="名前" Foreground="{StaticResource AppForeground}" />
              <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
              <TextBlock Text="開始（秒）" Foreground="{StaticResource AppForeground}" />
              <TextBox Text="{Binding StartSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
              <TextBlock Text="長さ（秒）" Foreground="{StaticResource AppForeground}" />
              <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
              <TextBlock Text="テキスト" Foreground="{StaticResource AppForeground}" />
              <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                       AcceptsReturn="True" Height="60" Margin="0,0,0,8" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
              <TextBlock Text="フォントサイズ" Foreground="{StaticResource AppForeground}" />
              <TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
            </StackPanel>

            <TextBlock Text="テキストアニメーション" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource AppForeground}" Visibility="{Binding IsTextClipSelected, Converter={StaticResource BoolToVis}}" />
            <StackPanel Visibility="{Binding IsTextClipSelected, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="イン（登場）" Foreground="{StaticResource AppForeground}" />
              <ComboBox SelectedValue="{Binding SelectedTextAnimationInKind, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,6" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                <ComboBoxItem Content="なし" Tag="{x:Static core:TextAnimationKind.None}" />
                <ComboBoxItem Content="フェードイン" Tag="{x:Static core:TextAnimationKind.Fade}" />
                <ComboBoxItem Content="スライドイン" Tag="{x:Static core:TextAnimationKind.Slide}" />
                <ComboBoxItem Content="タイプライター" Tag="{x:Static core:TextAnimationKind.Typewriter}" />
                <ComboBoxItem Content="カラオケ" Tag="{x:Static core:TextAnimationKind.Karaoke}" />
                <ComboBoxItem Content="スケールイン" Tag="{x:Static core:TextAnimationKind.Scale}" />
              </ComboBox>
              <StackPanel Visibility="{Binding ShowInDirection, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="方向" Foreground="{StaticResource AppForeground}" />
                <ComboBox SelectedValue="{Binding SelectedTextAnimationInDirection, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,6" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                  <ComboBoxItem Content="左から" Tag="{x:Static core:TextAnimationDirection.Left}" />
                  <ComboBoxItem Content="右から" Tag="{x:Static core:TextAnimationDirection.Right}" />
                  <ComboBoxItem Content="上から" Tag="{x:Static core:TextAnimationDirection.Up}" />
                  <ComboBoxItem Content="下から" Tag="{x:Static core:TextAnimationDirection.Down}" />
                </ComboBox>
              </StackPanel>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="長さ" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
                <TextBox Grid.Column="1" Text="{Binding SelectedTextAnimationInDurationSeconds, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                <TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource AppForeground}" />
              </Grid>
              <TextBlock Text="イージング" Foreground="{StaticResource AppForeground}" />
              <ComboBox SelectedValue="{Binding SelectedTextAnimationInEasing, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,6" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                <ComboBoxItem Content="線形" Tag="{x:Static core:TextAnimationEasing.Linear}" />
                <ComboBoxItem Content="イーズイン" Tag="{x:Static core:TextAnimationEasing.EaseIn}" />
                <ComboBoxItem Content="イーズアウト" Tag="{x:Static core:TextAnimationEasing.EaseOut}" />
                <ComboBoxItem Content="イーズイン・アウト" Tag="{x:Static core:TextAnimationEasing.EaseInOut}" />
              </ComboBox>
              <CheckBox Content="動きと同時にフェードする" IsChecked="{Binding SelectedTextAnimationInFade, Mode=TwoWay}" Margin="0,0,0,6" Foreground="{StaticResource AppForeground}" Visibility="{Binding ShowInFade, Converter={StaticResource BoolToVis}}" />
              <StackPanel Visibility="{Binding ShowInHighlightColor, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="カラオケのハイライト色（#RRGGBB）" Foreground="{StaticResource AppForeground}" />
                <TextBox Text="{Binding SelectedTextAnimationInHighlightColorHex, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
              </StackPanel>

              <TextBlock Text="アウト（退場）" Margin="0,8,0,0" Foreground="{StaticResource AppForeground}" />
              <ComboBox SelectedValue="{Binding SelectedTextAnimationOutKind, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,6" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                <ComboBoxItem Content="なし" Tag="{x:Static core:TextAnimationKind.None}" />
                <ComboBoxItem Content="フェードアウト" Tag="{x:Static core:TextAnimationKind.Fade}" />
                <ComboBoxItem Content="スライドアウト" Tag="{x:Static core:TextAnimationKind.Slide}" />
                <ComboBoxItem Content="スケールアウト" Tag="{x:Static core:TextAnimationKind.Scale}" />
              </ComboBox>
              <StackPanel Visibility="{Binding ShowOutDirection, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="方向" Foreground="{StaticResource AppForeground}" />
                <ComboBox SelectedValue="{Binding SelectedTextAnimationOutDirection, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,6" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                  <ComboBoxItem Content="左へ" Tag="{x:Static core:TextAnimationDirection.Left}" />
                  <ComboBoxItem Content="右へ" Tag="{x:Static core:TextAnimationDirection.Right}" />
                  <ComboBoxItem Content="上へ" Tag="{x:Static core:TextAnimationDirection.Up}" />
                  <ComboBoxItem Content="下へ" Tag="{x:Static core:TextAnimationDirection.Down}" />
                </ComboBox>
              </StackPanel>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="長さ" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
                <TextBox Grid.Column="1" Text="{Binding SelectedTextAnimationOutDurationSeconds, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                <TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource AppForeground}" />
              </Grid>
              <TextBlock Text="イージング" Foreground="{StaticResource AppForeground}" />
              <ComboBox SelectedValue="{Binding SelectedTextAnimationOutEasing, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,6" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                <ComboBoxItem Content="線形" Tag="{x:Static core:TextAnimationEasing.Linear}" />
                <ComboBoxItem Content="イーズイン" Tag="{x:Static core:TextAnimationEasing.EaseIn}" />
                <ComboBoxItem Content="イーズアウト" Tag="{x:Static core:TextAnimationEasing.EaseOut}" />
                <ComboBoxItem Content="イーズイン・アウト" Tag="{x:Static core:TextAnimationEasing.EaseInOut}" />
              </ComboBox>
              <CheckBox Content="動きと同時にフェードする" IsChecked="{Binding SelectedTextAnimationOutFade, Mode=TwoWay}" Margin="0,0,0,6" Foreground="{StaticResource AppForeground}" Visibility="{Binding ShowOutFade, Converter={StaticResource BoolToVis}}" />
              <TextBlock Text="タイプライターとカラオケは登場のみです。退場はフェード・スライド・スケールから選べます。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock Text="色調補正" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{StaticResource AppForeground}" />
            <Grid IsEnabled="{Binding HasSelectedClip}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="明るさ" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
              <Slider Grid.Row="0" Grid.Column="1" Minimum="-1" Maximum="1" VerticalAlignment="Center"
                      Value="{Binding SelectedClipBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      GotFocus="EditableField_GotFocus" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedClipBrightness, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource AppForeground}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="コントラスト" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
              <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2" VerticalAlignment="Center"
                      Value="{Binding SelectedClipContrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      GotFocus="EditableField_GotFocus" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedClipContrast, StringFormat={}{0:F2}}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource AppForeground}" />
            </Grid>

            <TextBlock Text="トランジション（開始側）" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource AppForeground}" />
            <StackPanel IsEnabled="{Binding HasSelectedClip}">
              <ComboBox SelectedValue="{Binding SelectedClipTransitionKind, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,6" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                <ComboBoxItem Content="なし" Tag="{x:Static core:TransitionKind.None}" />
                <ComboBoxItem Content="ディゾルブ" Tag="{x:Static core:TransitionKind.Dissolve}" />
              </ComboBox>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="長さ" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
                <TextBox Grid.Column="1" Text="{Binding SelectedClipTransitionDurationSeconds, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                <TextBlock Grid.Column="2" Text="秒" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource AppForeground}" />
              </Grid>
              <TextBlock Text="{Binding TransitionHint}" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="キーフレーム" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource AppForeground}" />
            <StackPanel IsEnabled="{Binding HasSelectedClip}">
              <ComboBox ItemsSource="{Binding KeyframeParameterOptions}" DisplayMemberPath="Display" SelectedValuePath="Value" SelectedValue="{Binding KeyframeParameter, Mode=TwoWay}" Margin="0,0,0,6" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
              </ComboBox>
              <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="時刻" Foreground="{StaticResource MutedForeground}" FontSize="11" />
                <TextBlock Grid.Column="1" Text="値" Foreground="{StaticResource MutedForeground}" FontSize="11" />
                <TextBlock Grid.Column="2" Text="補間" Foreground="{StaticResource MutedForeground}" FontSize="11" />
              </Grid>
              <ListBox ItemsSource="{Binding KeyframeRows}" MaxHeight="180"
                       Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding TimeSeconds, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                      <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                      <ComboBox Grid.Column="2" SelectedValue="{Binding Interpolation, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                        <ComboBoxItem Content="保持" Tag="{x:Static core:Interpolation.Hold}" />
                        <ComboBoxItem Content="線形" Tag="{x:Static core:Interpolation.Linear}" />
                        <ComboBoxItem Content="イージング" Tag="{x:Static core:Interpolation.EaseInOut}" />
                      </ComboBox>
                      <Button Grid.Column="3" Content="×" Padding="0" Click="DeleteKeyframeButton_Click" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="再生ヘッド位置に追加" Click="AddKeyframeButton_Click" IsEnabled="{Binding CanAddKeyframeAtPlayhead}" Margin="0,6,0,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
            </StackPanel>

            <TextBlock Text="ブレンド・効果" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{StaticResource AppForeground}" />
            <TextBlock Text="音声クリップには映像エフェクトは適用されません。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding IsAudioClipSelected, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="可視化クリップには映像エフェクトは適用されません（色・形は下の「可視化」欄で調整します）。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,4" Visibility="{Binding IsVisualizationClipSelected, Converter={StaticResource BoolToVis}}" />
            <StackPanel IsEnabled="{Binding HasVisualEffects}">
              <TextBlock Text="ブレンドモード" Foreground="{StaticResource AppForeground}" />
              <ComboBox SelectedValue="{Binding SelectedClipBlendMode, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,6" GotFocus="EditableField_GotFocus" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                <ComboBoxItem Content="通常" Tag="{x:Static core:BlendMode.Normal}" />
                <ComboBoxItem Content="加算" Tag="{x:Static core:BlendMode.Add}" />
                <ComboBoxItem Content="スクリーン" Tag="{x:Static core:BlendMode.Screen}" />
                <ComboBoxItem Content="乗算" Tag="{x:Static core:BlendMode.Multiply}" />
                <ComboBoxItem Content="オーバーレイ" Tag="{x:Static core:BlendMode.Overlay}" />
              </ComboBox>
              <TextBlock Text="エフェクト" Foreground="{StaticResource AppForeground}" />
              <ListBox ItemsSource="{Binding EffectRows}" MaxHeight="240"
                       Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
