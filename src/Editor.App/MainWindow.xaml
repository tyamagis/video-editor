<Window x:Class="Editor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Editor.App.Controls"
        Title="VideoEditor — フェーズ1" Width="1280" Height="800"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource AppForeground}">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" Foreground="{StaticResource AppForeground}">
      <MenuItem Header="ファイル">
        <MenuItem Header="素材を読み込む" Click="ImportMenu_Click" />
        <MenuItem Header="プロジェクトを保存" Click="SaveMenu_Click" />
        <MenuItem Header="プロジェクトを開く" Click="LoadMenu_Click" />
        <Separator />
        <MenuItem Header="MP4で書き出す" Click="ExportMenu_Click" />
      </MenuItem>
      <MenuItem Header="編集">
        <MenuItem Header="再生ヘッドで分割 (S)" Click="SplitMenu_Click" />
        <MenuItem Header="選択クリップを削除 (Del)" Click="DeleteMenu_Click" />
      </MenuItem>
    </Menu>

    <ToolBar DockPanel.Dock="Top" Background="{StaticResource PanelBackground}" Foreground="{StaticResource AppForeground}">
      <Button Content="{Binding PlayPauseLabel}" Command="{Binding PlayPauseCommand}" Width="80" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" />
      <Button Content="分割" Command="{Binding SplitCommand}" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" />
      <Button Content="削除" Command="{Binding DeleteClipCommand}" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" />
      <Button Content="テキスト追加" Command="{Binding AddTextClipCommand}" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" />
      <Separator />
      <TextBlock Text="BPM" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource AppForeground}" />
      <TextBox Text="{Binding Bpm, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalAlignment="Center" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
      <TextBlock Text="プレビュー" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{StaticResource AppForeground}" />
      <ComboBox x:Name="PreviewResBox" Width="80" SelectionChanged="PreviewResBox_SelectionChanged" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
        <ComboBoxItem Content="フル" IsSelected="True" />
        <ComboBoxItem Content="1/2" />
        <ComboBoxItem Content="1/4" />
      </ComboBox>
    </ToolBar>

    <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource PanelBackground}" Foreground="{StaticResource AppForeground}">
      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AppForeground}" />
    </StatusBar>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="5" />
        <RowDefinition Height="260" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <GroupBox Grid.Row="0" Grid.Column="0" Header="素材プール" Background="{StaticResource PanelBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ListBox Grid.Row="0" ItemsSource="{Binding MediaItems}" DisplayMemberPath="Display"
                   SelectedItem="{Binding SelectedMediaItem, Mode=TwoWay}"
                   Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}"
                   MouseDoubleClick="MediaList_MouseDoubleClick"
                   PreviewMouseLeftButtonDown="MediaList_PreviewMouseLeftButtonDown"
                   PreviewMouseMove="MediaList_PreviewMouseMove">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <EventSetter Event="MouseDoubleClick" Handler="MediaItem_MouseDoubleClick" />
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          <Button Grid.Row="1" Content="タイムラインに追加" Margin="0,6,0,0" Click="AddToTimelineButton_Click"
                  Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
        </Grid>
      </GroupBox>

      <controls:PreviewControl x:Name="PreviewControl" Grid.Row="0" Grid.Column="1" />

      <GroupBox Grid.Row="0" Grid.Column="2" Header="インスペクタ" Background="{StaticResource PanelBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
        <StackPanel DataContext="{Binding SelectedClip}" Margin="6">
          <TextBlock Text="名前" Foreground="{StaticResource AppForeground}" />
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
          <TextBlock Text="開始（秒）" Foreground="{StaticResource AppForeground}" />
          <TextBox Text="{Binding StartSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
          <TextBlock Text="長さ（秒）" Foreground="{StaticResource AppForeground}" />
          <TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
          <TextBlock Text="テキスト" Foreground="{StaticResource AppForeground}" />
          <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" Height="60" Margin="0,0,0,8" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
          <TextBlock Text="フォントサイズ" Foreground="{StaticResource AppForeground}" />
          <TextBox Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
          <TextBlock Text="キーフレーム編集・色調補正の詳細は次のステップで追加します。"
                     TextWrapping="Wrap" Foreground="{StaticResource MutedForeground}" />
        </StackPanel>
      </GroupBox>

      <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Background="{StaticResource ControlBorder}" />

      <controls:TimelineControl x:Name="TimelineControl" Grid.Row="2" Grid.ColumnSpan="3" />
    </Grid>
  </DockPanel>
</Window>
