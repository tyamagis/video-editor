                        <ComboBox Margin="0,4,0,0" SelectedValue="{Binding KeyColorHex, Mode=TwoWay}" SelectedValuePath="Tag" Visibility="{Binding ShowKeyColor, Converter={StaticResource BoolToVis}}" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                          <ComboBoxItem Content="キー色：緑" Tag="#00FF00" />
                          <ComboBoxItem Content="キー色：青" Tag="#0000FF" />
                        </ComboBox>
                      </StackPanel>
                    </Border>
