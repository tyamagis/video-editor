              <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="時刻" Foreground="{StaticResource MutedForeground}" FontSize="11" />
                <TextBlock Grid.Column="1" Text="名前" Foreground="{StaticResource MutedForeground}" FontSize="11" />
              </Grid>
              <ListBox ItemsSource="{Binding MarkerRows}" SelectedItem="{Binding SelectedMarker, Mode=TwoWay}" MaxHeight="180"
                       Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="2">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0" Text="{Binding TimeSeconds, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                      <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" GotFocus="EditableField_GotFocus" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                      <Button Grid.Column="2" Content="×" Padding="0" Click="DeleteMarkerButton_Click" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="再生ヘッド位置に追加 (M)" Click="AddMarkerButton_Click" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                <Button Grid.Column="1" Content="◀ 前" Click="PrevMarkerButton_Click" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                <Button Grid.Column="2" Content="次 ▶" Click="NextMarkerButton_Click" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
              </Grid>
              <TextBlock Text="曲の区切り（サビ・ドロップなど）に名前付きの印を付けます。ルーラー上のマーカーはドラッグで移動できます。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </GroupBox>

      <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Background="{StaticResource ControlBorder}" />

      <controls:TimelineControl x:Name="TimelineControl" Grid.Row="2" Grid.ColumnSpan="3" />
    </Grid>
  </DockPanel>
</Window>
