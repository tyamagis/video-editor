                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SilenceThresholdDb, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,2" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="dB" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource AppForeground}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="最短無音" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SilenceMinSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,2" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="秒" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource AppForeground}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="前後余白" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SilenceMarginSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="秒" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource AppForeground}" />
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="無音区間を検出" Click="DetectSilenceButton_Click" IsEnabled="{Binding CanDetectSilence}" Margin="0,0,4,0" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
