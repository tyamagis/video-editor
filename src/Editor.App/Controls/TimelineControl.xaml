<UserControl x:Class="Editor.App.Controls.TimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             Background="{StaticResource PanelBackground}"
             AllowDrop="True" Drop="TimelineControl_Drop" DragOver="TimelineControl_DragOver">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4" Background="{StaticResource PanelBackground}">
      <TextBlock Text="グリッド" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource AppForeground}" />
      <ComboBox x:Name="GridModeBox" Width="90" SelectionChanged="GridModeBox_SelectionChanged" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}">
        <ComboBoxItem Content="フレーム" Tag="Frame" IsSelected="True" />
        <ComboBoxItem Content="秒" Tag="Second" />
        <ComboBoxItem Content="拍" Tag="Beat" />
      </ComboBox>
      <CheckBox x:Name="ShowWaveformBox" Content="波形表示" Margin="12,0,0,0" Foreground="{StaticResource AppForeground}"
                IsChecked="True" Checked="ShowWaveformBox_Changed" Unchecked="ShowWaveformBox_Changed" />
      <CheckBox x:Name="SnapBox" Content="スナップ" Margin="12,0,0,0" IsChecked="True" Foreground="{StaticResource AppForeground}" />
      <TextBlock Text="ズーム" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{StaticResource AppForeground}" />
      <Slider x:Name="ZoomSlider" Width="120" Minimum="20" Maximum="400" Value="80"
              VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged" Foreground="{StaticResource AppForeground}" />
      <Button x:Name="SplitButton" Content="分割 (S)" Margin="12,0,0,0" Click="SplitButton_Click" Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
    </StackPanel>
    <skia:SKElement x:Name="TimelineElement" PaintSurface="OnPaintSurface"
                    MouseLeftButtonDown="OnMouseLeftButtonDown"
                    MouseMove="OnMouseMove"
                    MouseLeftButtonUp="OnMouseLeftButtonUp" />
  </DockPanel>
</UserControl>
