<Window x:Class="Editor.App.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MP4で書き出す" Width="420" Height="560"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource AppForeground}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
  <StackPanel Margin="12">
    <TextBlock Text="プリセット" Foreground="{StaticResource AppForeground}" />
    <ComboBox x:Name="PresetBox" Margin="0,0,0,8" SelectionChanged="PresetBox_SelectionChanged"
              Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
    <TextBlock Text="プリセットを選ぶと下の設定欄に値が反映されます。設定欄を変えて書き出すこともできます。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,10" />

    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="解像度（幅 × 高さ）" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
      <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
        <TextBox x:Name="WidthBox" Width="80" />
        <TextBlock Text="×" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource AppForeground}" />
        <TextBox x:Name="HeightBox" Width="80" />
      </StackPanel>
      <TextBlock Text="フレームレート（fps）" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
      <TextBox x:Name="FrameRateBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />
      <TextBlock Text="CRF（0〜51）" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
      <TextBox x:Name="CrfBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
      <TextBlock Text="エンコーダープリセット" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
      <ComboBox x:Name="EncoderPresetBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                Background="{StaticResource ControlBackground}" Foreground="{StaticResource AppForeground}" BorderBrush="{StaticResource ControlBorder}" />
      <TextBlock Text="音声ビットレート（kbps）" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource AppForeground}" />
      <TextBox x:Name="AudioBitrateBox" Grid.Row="4" Grid.Column="1" />
    </Grid>
    <TextBlock Text="CRF が小さいほど高画質・大容量です。エンコーダープリセットは遅いほど高画質です。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,8" />

    <Separator Margin="0,8,0,8" />

    <TextBlock Text="現在の設定をプリセットとして保存" Foreground="{StaticResource AppForeground}" />
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <TextBox x:Name="PresetNameBox" Width="200" Margin="0,0,8,0" />
      <Button Content="プリセットとして保存" Click="SavePresetButton_Click" />
    </StackPanel>
    <TextBlock Text="同名のプリセットがある場合は上書きします（確認します）。既定プリセットと同じ名前は使えません。" FontSize="11" Foreground="{StaticResource MutedForeground}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <Button x:Name="DeletePresetButton" Content="選択中のプリセットを削除" Click="DeletePresetButton_Click" HorizontalAlignment="Left" Margin="0,0,0,12" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="書き出す" Click="OkButton_Click" Margin="0,0,8,0" IsDefault="True" />
      <Button Content="キャンセル" Click="CancelButton_Click" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
