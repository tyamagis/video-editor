<Application x:Class="Editor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- ダークテーマ：彩度0のダークグレー基調 -->
    <SolidColorBrush x:Key="AppBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="PanelBackground" Color="#252525" />
    <SolidColorBrush x:Key="ControlBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ControlBorder" Color="#3D3D3D" />
    <SolidColorBrush x:Key="AppForeground" Color="#D8D8D8" />
    <SolidColorBrush x:Key="MutedForeground" Color="#9A9A9A" />
    <!-- フォーカス表示だけに使う控えめなアクセント -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5B8DB8" />

    <!-- メニュー：ドロップダウンの中身も暗背景＋明文字にする。
         既定テーマだとドロップダウン背景が白のまま文字色だけ明るくなり読めなくなる。 -->
    <Style TargetType="MenuItem">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" />
      <Setter Property="Foreground" Value="{StaticResource AppForeground}" />
      <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
    </Style>

    <!-- コンボボックス：本体とドロップダウンの項目を暗背景＋明文字にする -->
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource ControlBackground}" />
      <Setter Property="Foreground" Value="{StaticResource AppForeground}" />
      <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{StaticResource ControlBackground}" />
      <Setter Property="Foreground" Value="{StaticResource AppForeground}" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#3D3D3D" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#3D3D3D" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ボタン：フラットで角丸。既定の立体的なクロームをやめる -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource ControlBackground}" />
      <Setter Property="Foreground" Value="{StaticResource AppForeground}" />
      <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="#3A3A3A" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="#464646" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="border" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- テキストボックス：角丸、フォーカス時はアクセント色の枠線 -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource ControlBackground}" />
      <Setter Property="Foreground" Value="{StaticResource AppForeground}" />
      <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
      <Setter Property="CaretBrush" Value="{StaticResource AppForeground}" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="border" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="border" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- グループボックス：フラットで角丸、見出しを枠の上に置く -->
    <Style TargetType="GroupBox">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" />
      <Setter Property="Foreground" Value="{StaticResource AppForeground}" />
      <Setter Property="BorderBrush" Value="{StaticResource ControlBorder}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupBox">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <ContentPresenter Grid.Row="0" ContentSource="Header" Margin="8,4,0,4"
                                TextElement.FontSize="12" TextElement.FontWeight="SemiBold" />
              <Border Grid.Row="1" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                      CornerRadius="6" Padding="6">
                <ContentPresenter />
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ツールバー：つまみ（グリップ）とグラデーションをなくしてフラットにする -->
    <Style TargetType="ToolBar">
      <Setter Property="Background" Value="{StaticResource PanelBackground}" />
      <Setter Property="Foreground" Value="{StaticResource AppForeground}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolBar">
            <Border Background="{TemplateBinding Background}" Padding="4,2">
              <ToolBarPanel IsItemsHost="True" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
