<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- FFmpeg 呼び出し（設計プラン 3章）。プローブは FFMpegCore、
         書き出し・サムネイルは ffmpeg CLI を直接呼ぶ。 -->
    <PackageReference Include="FFMpegCore" Version="5.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- プリセット保存で JsonDefaults / AtomicFile（Editor.Core）を使う。 -->
    <ProjectReference Include="..\Editor.Core\Editor.Core.csproj" />
  </ItemGroup>

</Project>
